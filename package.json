    "build:local-stack": "npm run typecheck && vite build --mode local-stack",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "axios": "^1.20.0",
    "jwt-decode": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vue-tsc": "^3.3.13"
  }
