{
  "name": "telegram-miniapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode local-stack",
    "typecheck": "vue-tsc -b",
    "build": "npm run typecheck && vite build --mode prod",
