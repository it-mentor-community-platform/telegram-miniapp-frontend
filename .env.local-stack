# Local stack (local-stack/docker-compose.yml). Used by `npm run dev` and images built from any
# branch other than staging and prod. Override per developer in .env.local-stack.local (git-ignored),
# e.g. VITE_TELEGRAM_BOT_USERNAME of your own local bot.
VITE_API_BASE_URL=http://localhost:8080
VITE_TELEGRAM_BOT_USERNAME=it_mentor_community_local_bot
VITE_SHOW_DEV_TOOLS=true
