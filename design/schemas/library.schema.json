{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library.schema.json",
  "title": "Design component library registry",
  "type": "object",
  "required": ["library", "label", "implementation", "penpot", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "library": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": { "type": "string", "minLength": 1 },
    "implementation": {
      "type": "object",
      "required": ["package", "majorVersion"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "majorVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "penpot": {
      "type": "object",
      "required": ["pageName", "componentPrefix", "fidelity"],
      "properties": {
        "pageName": { "type": "string", "minLength": 1 },
        "componentPrefix": { "type": "string", "minLength": 1 },
        "fidelity": { "const": "representative" }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": ["import", "props", "slots", "penpotTemplate"],
      "properties": {
        "import": { "type": "string", "minLength": 1 },
        "props": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "penpotAudit": {
          "type": "object",
          "required": ["adapter", "internals", "textProps", "observableStates"],
          "properties": {
            "adapter": { "enum": ["container", "text", "button", "progress", "options", "shape"] },
            "internals": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "textProps": { "type": "object", "additionalProperties": { "type": "string" } },
            "observableStates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "icons": { "type": "object", "additionalProperties": { "type": "string" } },
            "inactiveNativeBranches": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "type": "object", "required": ["sourceName", "slot", "family", "children"],
                "properties": {
                  "sourceName": { "enum": ["BackButton", "EndButton"] },
                  "slot": { "enum": ["start", "end"] },
                  "family": { "const": "Library/PrimeVue/Button" },
                  "children": { "const": ["Label", "TrailingIcon"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "penpotTemplate": {
          "type": "object",
          "required": ["appearances", "states"],
          "properties": {
            "appearances": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "variants": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "colorTreatments": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "const": "accessible-blue" }
            },
            "sizes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prop": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "array", "object"]
        },
        "required": { "type": "boolean" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}