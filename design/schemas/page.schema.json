{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page.schema.json",
  "title": "Design page specification",
  "type": "object",
  "required": ["feature", "page", "frame", "layout", "children"],
  "properties": {
    "$schema": { "type": "string" },
    "feature": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "page": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "frame": { "type": "object" },
    "layout": { "type": "object" },
    "children": {
      "type": "array",
      "items": { "$ref": "node.schema.json" }
    },
    "states": { "type": "object" },
    "requirements": {
      "type": "object",
      "required": ["sources", "approvedAssumptions"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "approvedAssumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}