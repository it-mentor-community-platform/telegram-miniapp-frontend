{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "custom-component.schema.json",
  "title": "Project-owned custom component",
  "type": "object",
  "required": ["kind", "name", "rationale", "props", "variants"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "custom-component" },
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "rationale": { "type": "string", "minLength": 1 },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["string", "number", "boolean", "array", "object"] },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["previewProps", "composition"],
        "properties": {
          "previewProps": {
            "type": "object",
            "description": "Literal representative inputs, validated against the custom props. Never used as runtime defaults or overrides."
          },
          "composition": {
            "$ref": "#/$defs/namedNode",
            "description": "Complete state tree; no inheritance, implicit flags, or overrides. Bindings reference custom props only."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "namedNode": {
      "allOf": [
        { "$ref": "node.schema.json" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/namedNode" } },
            "slots": {
              "type": "object",
              "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/namedNode" } }
            }
          }
        }
      ]
    }
  }
}