{
  "$schema": "../schemas/custom-component.schema.json",
  "kind": "custom-component",
  "name": "CategorySelectionRow",
  "rationale": "Recurring domain row that combines category selection, progress, mutation state, and navigation to details.",
  "props": {
    "title": { "type": "string", "required": true },
    "questionCount": { "type": "string", "required": true },
    "progress": { "type": "string", "required": false },
    "action": { "type": "string", "required": true }
  },
  "variants": {
    "available": { "selected": false, "disabled": false, "loading": false },
    "selected": { "selected": true, "disabled": false, "loading": false },
    "saving": { "selected": false, "disabled": true, "loading": true },
    "disabled": { "selected": false, "disabled": true, "loading": false }
  },
  "composition": {
    "type": "library-component",
    "library": "primevue",
    "component": "Card",
    "design": { "appearance": "default", "state": "default" },
    "slots": {
      "content": [
        { "type": "text", "name": "Title", "value": { "bind": "title" } },
        { "type": "text", "name": "QuestionCount", "value": { "bind": "questionCount" } },
        { "type": "text", "name": "ProgressText", "value": { "bind": "progress" } }
      ],
      "footer": [
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Button",
          "props": { "label": { "bind": "action" }, "severity": "primary", "variant": "text" },
          "action": { "type": "command", "name": "toggleCategorySelection" },
          "design": { "appearance": "primary", "variant": "text", "size": "normal", "state": "default" }
        },
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Button",
          "props": { "label": "Подробнее", "severity": "primary", "variant": "text" },
          "action": { "type": "command", "name": "openCategoryDetails" },
          "design": { "appearance": "primary", "variant": "text", "size": "normal", "state": "default" }
        }
      ]
    }
  }
}