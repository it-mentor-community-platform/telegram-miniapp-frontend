{
  "$schema": "../schemas/library.schema.json",
  "library": "primevue",
  "label": "PrimeVue",
  "implementation": {
    "package": "primevue",
    "majorVersion": 4
  },
  "penpot": {
    "pageName": "Library / PrimeVue",
    "componentPrefix": "Library / PrimeVue/",
    "fidelity": "representative"
  },
  "components": {
    "Accordion": {
      "import": "primevue/accordion",
      "penpotAudit": { "adapter": "container", "internals": ["Primary", "Secondary"], "textProps": {}, "observableStates": ["collapsed", "expanded"] },
      "props": { "value": { "type": "array" }, "multiple": { "type": "boolean" } },
      "slots": ["default"],
      "penpotTemplate": { "appearances": ["default"], "states": ["collapsed", "expanded"] }
    },
    "AccordionPanel": {
      "import": "primevue/accordionpanel",
      "penpotAudit": { "adapter": "container", "internals": ["Primary", "Secondary"], "textProps": {}, "observableStates": ["collapsed", "expanded"] },
      "props": { "value": { "type": "string", "required": true }, "disabled": { "type": "boolean" } },
      "slots": ["header", "content"],
      "penpotTemplate": { "appearances": ["default", "new", "due", "scheduled", "learned"], "states": ["collapsed", "expanded", "disabled"] }
    },
    "Avatar": {
      "import": "primevue/avatar",
      "penpotAudit": { "adapter": "text", "internals": ["Label"], "textProps": { "label": "Label" }, "observableStates": ["default", "locked"] },
      "props": { "label": { "type": "string" }, "icon": { "type": "string" }, "image": { "type": "string" }, "shape": { "type": "string", "enum": ["square", "circle"] }, "size": { "type": "string", "enum": ["normal", "large", "xlarge"] } },
      "slots": [],
      "penpotTemplate": { "appearances": ["default", "achievement"], "states": ["default", "locked"] }
    },
    "Badge": {
      "import": "primevue/badge",
      "penpotAudit": { "adapter": "text", "internals": ["Value"], "textProps": { "value": "Value" }, "observableStates": ["default"] },
      "props": { "value": { "type": "string" }, "severity": { "type": "string", "enum": ["secondary", "success", "info", "warn", "danger", "contrast"] } },
      "slots": [],
      "penpotTemplate": { "appearances": ["default"], "states": ["default"] }
    },
    "Button": {
      "import": "primevue/button",
      "penpotAudit": { "adapter": "button", "internals": ["Label", "LeadingIcon", "TrailingIcon", "LoadingIndicator"], "textProps": { "label": "Label" }, "observableStates": ["default", "loading", "disabled"], "icons": { "pi pi-times": "×", "pi pi-arrow-right": "→", "pi pi-arrow-left": "←", "pi pi-plus": "+", "pi pi-play": "▶" } },
      "props": { "aria-label": { "type": "string" }, "label": { "type": "string" }, "icon": { "type": "string" }, "iconPos": { "type": "string", "enum": ["left", "right", "top", "bottom"] }, "severity": { "type": "string", "enum": ["primary", "secondary", "success", "info", "warn", "help", "danger", "contrast"] }, "variant": { "type": "string", "enum": ["outlined", "text", "link"] }, "size": { "type": "string", "enum": ["small", "large"] }, "disabled": { "type": "boolean" }, "loading": { "type": "boolean" }, "fluid": { "type": "boolean" } },
      "slots": ["default"],
      "penpotTemplate": { "colorTreatments": ["accessible-blue"], "appearances": ["primary", "secondary", "danger"], "variants": ["filled", "outlined", "text", "link"], "sizes": ["small", "normal", "large"], "states": ["default", "disabled", "loading"] }
    },
    "Card": {
      "import": "primevue/card",
      "penpotAudit": { "adapter": "container", "internals": ["Primary", "Secondary"], "textProps": {}, "observableStates": ["default"] },
      "props": {},
      "slots": ["header", "title", "subtitle", "content", "footer"],
      "penpotTemplate": { "appearances": ["default", "action", "highlighted", "metric"], "states": ["default", "disabled", "loading"] }
    },
    "IconField": {
      "import": "primevue/iconfield",
      "penpotAudit": { "adapter": "container", "internals": ["LeadingIcon"], "textProps": {}, "observableStates": ["default"] },
      "props": {},
      "slots": ["default"],
      "penpotTemplate": { "appearances": ["default"], "variants": ["outlined", "filled"], "sizes": ["small", "normal", "large"], "states": ["default", "focused", "disabled"] }
    },
    "InputText": {
      "import": "primevue/inputtext",
      "penpotAudit": { "adapter": "text", "internals": ["Value", "Placeholder", "LeadingIcon"], "textProps": { "modelValue": "Value", "placeholder": "Placeholder" }, "observableStates": ["default"] },
      "props": { "aria-label": { "type": "string" }, "placeholder": { "type": "string" }, "variant": { "type": "string", "enum": ["outlined", "filled"] }, "size": { "type": "string", "enum": ["small", "large"] }, "fluid": { "type": "boolean" }, "disabled": { "type": "boolean" }, "invalid": { "type": "boolean" }, "modelValue": { "type": "string" } },
      "slots": [],
      "penpotTemplate": { "appearances": ["default", "search"], "variants": ["outlined", "filled"], "sizes": ["small", "normal", "large"], "states": ["default", "focused", "disabled", "invalid"] }
    },
    "Message": {
      "import": "primevue/message",
      "penpotAudit": { "adapter": "container", "internals": ["Primary", "Secondary"], "textProps": {}, "observableStates": ["default", "loading"] },
      "props": { "severity": { "type": "string", "enum": ["success", "info", "warn", "error", "secondary", "contrast"] }, "closable": { "type": "boolean" } },
      "slots": ["default"],
      "penpotTemplate": { "appearances": ["success", "info", "error"], "states": ["default", "loading"] }
    },
    "OverlayBadge": {
      "import": "primevue/overlaybadge",
      "penpotAudit": { "adapter": "container", "internals": ["Value"], "textProps": { "value": "Value" }, "observableStates": ["default"] },
      "props": { "value": { "type": "string" }, "severity": { "type": "string", "enum": ["secondary", "success", "info", "warn", "danger", "contrast"] } },
      "slots": ["default"],
      "penpotTemplate": { "appearances": ["default"], "states": ["default"] }
    },
    "ProgressBar": {
      "import": "primevue/progressbar",
      "penpotAudit": { "adapter": "progress", "internals": ["Value", "Indicator"], "textProps": {}, "observableStates": ["determinate", "indeterminate"] },
      "props": { "value": { "type": "number" }, "showValue": { "type": "boolean" }, "mode": { "type": "string", "enum": ["determinate", "indeterminate"] } },
      "slots": ["default"],
      "penpotTemplate": { "appearances": ["default"], "states": ["determinate", "indeterminate"] }
    },
    "ProgressSpinner": {
      "import": "primevue/progressspinner",
      "penpotAudit": { "adapter": "shape", "internals": ["Indicator"], "textProps": {}, "observableStates": [] },
      "props": { "strokeWidth": { "type": "string" } },
      "slots": [],
      "penpotTemplate": { "appearances": ["default"], "states": ["loading"] }
    },
    "Select": {
      "import": "primevue/select",
      "penpotAudit": { "adapter": "text", "internals": ["Value", "Placeholder", "DropdownIcon"], "textProps": { "modelValue": "Value", "placeholder": "Placeholder" }, "observableStates": ["default"] },
      "props": {
        "aria-label": { "type": "string" },
        "options": { "type": "array", "required": true },
        "modelValue": { "type": "string" },
        "placeholder": { "type": "string" },
        "fluid": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "invalid": { "type": "boolean" }
      },
      "slots": [],
      "penpotTemplate": { "appearances": ["default"], "states": ["default", "focused", "expanded", "disabled", "invalid"] }
    },
    "SelectButton": {
      "import": "primevue/selectbutton",
      "penpotAudit": { "adapter": "options", "internals": [], "textProps": {}, "observableStates": ["default"] },
      "props": { "options": { "type": "array", "required": true }, "modelValue": { "type": "number" }, "disabled": { "type": "boolean" }, "allowEmpty": { "type": "boolean" } },
      "slots": ["option"],
      "penpotTemplate": { "colorTreatments": ["accessible-blue"], "appearances": ["rating-scale"], "states": ["default", "selected", "disabled", "loading"] }
    },
    "Skeleton": {
      "import": "primevue/skeleton",
      "penpotAudit": { "adapter": "shape", "internals": [], "textProps": {}, "observableStates": ["loading"] },
      "props": { "width": { "type": "string" }, "height": { "type": "string" }, "shape": { "type": "string", "enum": ["rectangle", "circle"] } },
      "slots": [],
      "penpotTemplate": { "appearances": ["default"], "states": ["loading"] }
    },
    "Tag": {
      "import": "primevue/tag",
      "penpotAudit": { "adapter": "text", "internals": ["Value", "Label"], "textProps": { "value": "Value" }, "observableStates": ["default"] },
      "props": { "value": { "type": "string", "required": true }, "severity": { "type": "string", "enum": ["secondary", "success", "info", "warn", "danger", "contrast"] }, "icon": { "type": "string" } },
      "slots": ["default"],
      "penpotTemplate": { "colorTreatments": ["accessible-blue"], "appearances": ["default", "specialization"], "states": ["default"] }
    },
    "Textarea": {
      "import": "primevue/textarea",
      "penpotAudit": { "adapter": "text", "internals": ["Value", "Placeholder"], "textProps": { "placeholder": "Placeholder" }, "observableStates": ["default"] },
      "props": { "placeholder": { "type": "string" }, "variant": { "type": "string", "enum": ["outlined", "filled"] }, "size": { "type": "string", "enum": ["small", "large"] }, "fluid": { "type": "boolean" }, "autoResize": { "type": "boolean" }, "disabled": { "type": "boolean" }, "invalid": { "type": "boolean" }, "rows": { "type": "number" } },
      "slots": [],
      "penpotTemplate": { "appearances": ["default"], "variants": ["outlined", "filled"], "sizes": ["small", "normal", "large"], "states": ["default", "focused", "disabled", "invalid"] }
    },
    "Timeline": {
      "import": "primevue/timeline",
      "penpotAudit": { "adapter": "container", "internals": [], "textProps": {}, "observableStates": ["default"] },
      "props": { "value": { "type": "array" }, "align": { "type": "string", "enum": ["left", "right", "alternate"] }, "layout": { "type": "string", "enum": ["vertical", "horizontal"] } },
      "slots": ["marker", "content", "opposite"],
      "penpotTemplate": { "appearances": ["activity"], "states": ["default"] }
    },
    "Toolbar": {
      "import": "primevue/toolbar",
      "penpotAudit": { "adapter": "container", "internals": ["Title", "PageTitle", "EndAction"], "textProps": {}, "observableStates": ["root", "back", "close"], "inactiveNativeBranches": [{ "sourceName": "BackButton", "slot": "start", "family": "Library/PrimeVue/Button", "children": ["Label", "TrailingIcon"] }, { "sourceName": "EndButton", "slot": "end", "family": "Library/PrimeVue/Button", "children": ["Label", "TrailingIcon"] }] },
      "props": {},
      "slots": ["start", "center", "end"],
      "penpotTemplate": { "appearances": ["page-header"], "states": ["root", "back", "close"] }
    }
  }
}