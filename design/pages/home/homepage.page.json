{
  "$schema": "../../schemas/page.schema.json",
  "feature": {
    "key": "home",
    "label": "Home"
  },
  "page": "Homepage",
  "frame": {
    "width": 390,
    "background": "color.background",
    "padding": "spacing.lg"
  },
  "layout": {
    "type": "column",
    "gap": "spacing.lg",
    "align": "stretch"
  },
  "children": [
    {
      "type": "section",
      "name": "ProfileSection",
      "children": [
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Card",
          "design": { "appearance": "default", "state": "default" },
          "slots": {
            "content": [
              { "type": "library-component", "library": "primevue", "component": "Avatar", "props": { "label": "ИП", "shape": "circle", "size": "large" }, "style": { "color": "color.accessiblePrimary" }, "design": { "appearance": "default", "state": "default" } },
              { "type": "text", "name": "ProfileName", "value": "Иван Петров" },
              { "type": "library-component", "library": "primevue", "component": "Tag", "props": { "value": "Студент", "severity": "info" }, "design": { "appearance": "default", "state": "default", "colorTreatment": "accessible-blue" } },
              { "type": "text", "name": "ProfileStats", "value": "5 проектов" }
            ]
          }
        }
      ]
    },
    {
      "type": "section",
      "name": "QuickActionsSection",
      "children": [
        {
          "type": "text",
          "name": "QuickActionsTitle",
          "value": "Быстрые действия",
          "style": {
            "fontFamily": "font.family.base",
            "fontSize": "font.size.lg",
            "fontWeight": "font.weight.bold",
            "color": "color.text"
          }
        },
        {
          "type": "grid",
          "name": "QuickActions",
          "columns": 2,
          "gap": "spacing.md",
          "style": {
            "width": "100%",
            "alignItems": "stretch"
          },
          "children": [
            { "type": "library-component", "library": "primevue", "component": "Card", "style": { "minHeight": 100 }, "design": { "appearance": "action", "state": "default" }, "action": { "type": "command", "name": "openProjectSubmission" }, "slots": { "content": [{ "type": "text", "name": "SubmitProjectAction", "value": "➕\nСдать проект" }] } },
            { "type": "library-component", "library": "primevue", "component": "Card", "style": { "minHeight": 100 }, "design": { "appearance": "default", "state": "default" }, "action": { "type": "command", "name": "openOwnProfile" }, "slots": { "content": [{ "type": "text", "name": "OwnProfileAction", "value": "👤\nМой профиль" }] } },
            { "type": "library-component", "library": "primevue", "component": "Card", "style": { "minHeight": 100 }, "design": { "appearance": "default", "state": "default" }, "action": { "type": "command", "name": "openOwnProjects" }, "slots": { "content": [{ "type": "text", "name": "OwnProjectsAction", "value": "📚\nМои проекты" }] } },
            { "type": "library-component", "library": "primevue", "component": "Card", "style": { "minHeight": 100 }, "design": { "appearance": "default", "state": "default" }, "action": { "type": "command", "name": "openMentorSearch" }, "slots": { "content": [{ "type": "text", "name": "MentorSearchAction", "value": "🔍\nНайти ментора" }] } },
            { "type": "library-component", "library": "primevue", "component": "Card", "style": { "minHeight": 100 }, "design": { "appearance": "highlighted", "state": "default" }, "action": { "type": "navigate", "target": "RepetitionDashboard", "fallbackTarget": "CategorySetup" }, "slots": { "content": [{ "type": "text", "name": "RepetitionAction", "value": "🧠\nПовторение вопросов\nНовые и запланированные вопросы" }] } }
          ]
        }
      ]
    },
    {
      "type": "section",
      "name": "AchievementsSection",
      "style": {
        "padding": "spacing.md",
        "background": "color.surface",
        "borderRadius": "radius.lg"
      },
      "children": [
        {
          "type": "text",
          "name": "AchievementsTitle",
          "value": "🏆 Твои достижения",
          "style": {
            "fontFamily": "font.family.base",
            "fontSize": "font.size.md",
            "fontWeight": "font.weight.semibold",
            "color": "color.text",
            "marginBottom": "spacing.md"
          }
        },
        {
          "type": "row",
          "name": "AchievementsList",
          "gap": "spacing.sm",
          "children": [
            { "type": "library-component", "library": "primevue", "component": "Avatar", "props": { "label": "🌟", "size": "large" }, "design": { "appearance": "achievement", "state": "default" } },
            { "type": "library-component", "library": "primevue", "component": "Avatar", "props": { "label": "🎯", "size": "large" }, "design": { "appearance": "achievement", "state": "locked" } },
            { "type": "library-component", "library": "primevue", "component": "Avatar", "props": { "label": "🌐", "size": "large" }, "design": { "appearance": "achievement", "state": "locked" } },
            { "type": "library-component", "library": "primevue", "component": "Avatar", "props": { "label": "🏅", "size": "large" }, "design": { "appearance": "achievement", "state": "locked" } }
          ]
        },
        {
          "type": "text",
          "name": "MoreAchievements",
          "value": "Еще 5 достижений →",
          "style": {
            "fontFamily": "font.family.base",
            "fontSize": "font.size.sm",
            "fontWeight": "font.weight.medium",
            "color": "color.accessiblePrimary",
            "marginTop": "spacing.sm"
          }
        }
      ]
    },
    {
      "type": "section",
      "name": "ActivitySection",
      "style": {
        "width": "100%"
      },
      "children": [
        {
          "type": "text",
          "name": "ActivityTitle",
          "value": "📱 Последняя активность",
          "style": {
            "fontFamily": "font.family.base",
            "fontSize": "font.size.lg",
            "fontWeight": "font.weight.bold",
            "color": "color.text"
          }
        },
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Timeline",
          "props": {
            "value": [
              { "icon": "✅", "title": "Сдан проект: Виселица", "description": "Java • Проект #1", "time": "Сегодня, 15:30" },
              { "icon": "🏆", "title": "Получена ачивка", "description": "Первый проект", "time": "Вчера, 20:15" }
            ],
            "align": "left",
            "layout": "vertical"
          },
          "design": { "appearance": "activity", "state": "default" }
        }
      ]
    },
    {
      "type": "section",
      "name": "CommunityStatsSection",
      "style": {
        "width": "100%",
        "padding": "spacing.md",
        "background": "color.surface",
        "borderRadius": "radius.lg"
      },
      "children": [
        {
          "type": "text",
          "name": "CommunityStatsTitle",
          "value": "📊 Статистика сообщества",
          "style": {
            "fontFamily": "font.family.base",
            "fontSize": "font.size.md",
            "fontWeight": "font.weight.semibold",
            "color": "color.text",
            "marginBottom": "spacing.sm"
          }
        },
        {
          "type": "column",
          "name": "StatsList",
          "gap": "spacing.xs",
          "style": {
            "width": "100%"
          },
          "children": [
            {
              "type": "text",
              "name": "Stat1",
              "value": "• 1800+ участников",
              "style": {
                "fontFamily": "font.family.base",
                "fontSize": "font.size.sm",
                "fontWeight": "font.weight.regular",
                "color": "color.text"
              }
            },
            {
              "type": "text",
              "name": "Stat2",
              "value": "• 500+ проектов сдано",
              "style": {
                "fontFamily": "font.family.base",
                "fontSize": "font.size.sm",
                "fontWeight": "font.weight.regular",
                "color": "color.text"
              }
            },
            {
              "type": "text",
              "name": "Stat3",
              "value": "• 200+ ревью проведено",
              "style": {
                "fontFamily": "font.family.base",
                "fontSize": "font.size.sm",
                "fontWeight": "font.weight.regular",
                "color": "color.text"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "name": "UsefulLinksSection",
      "style": {
        "width": "100%"
      },
      "children": [
        {
          "type": "text",
          "name": "LinksTitle",
          "value": "🔗 Полезные ссылки",
          "style": {
            "fontFamily": "font.family.base",
            "fontSize": "font.size.lg",
            "fontWeight": "font.weight.bold",
            "color": "color.text"
          }
        },
        {
          "type": "column",
          "name": "UsefulLinks",
          "gap": "spacing.sm",
          "style": {
            "width": "100%"
          },
          "children": [
            { "type": "library-component", "library": "primevue", "component": "Button", "props": { "label": "📖 Java роадмап", "icon": "pi pi-arrow-right", "iconPos": "right", "severity": "primary", "fluid": true }, "action": { "type": "external-link", "url": "java-roadmap" }, "design": { "appearance": "primary", "variant": "filled", "size": "normal", "state": "default", "colorTreatment": "accessible-blue" } },
            { "type": "library-component", "library": "primevue", "component": "Button", "props": { "label": "🐍 Python роадмап", "icon": "pi pi-arrow-right", "iconPos": "right", "severity": "primary", "fluid": true }, "action": { "type": "external-link", "url": "python-roadmap" }, "design": { "appearance": "primary", "variant": "filled", "size": "normal", "state": "default", "colorTreatment": "accessible-blue" } },
            { "type": "library-component", "library": "primevue", "component": "Button", "props": { "label": "💬 Перейти в чат", "icon": "pi pi-arrow-right", "iconPos": "right", "severity": "primary", "fluid": true }, "action": { "type": "external-link", "url": "community-chat" }, "design": { "appearance": "primary", "variant": "filled", "size": "normal", "state": "default", "colorTreatment": "accessible-blue" } },
            { "type": "library-component", "library": "primevue", "component": "Button", "props": { "label": "📺 YouTube канал", "icon": "pi pi-arrow-right", "iconPos": "right", "severity": "primary", "fluid": true }, "action": { "type": "external-link", "url": "youtube-channel" }, "design": { "appearance": "primary", "variant": "filled", "size": "normal", "state": "default", "colorTreatment": "accessible-blue" } }
          ]
        }
      ]
    }
  ],
  "states": {
    "openOwnProjects": "Require STUDENT, including multi-role users. openOwnProjects opens the MyProjects logical route; choose the representative layout from actual student data, not a fixed preview.",
    "openProjectSubmission": "Require STUDENT, including multi-role users. openProjectSubmission opens MyProjects in submission-choice context with Выберите проект для сдачи; project selection opens ProjectType with first/additional form visibility. No separate submission route."
  },
  "requirements": {
    "sources": [
      "meta/business-analytics/functionality/student-roadmap-completion.md",
      "meta/business-analytics/functionality/user-profiles.md",
      "meta/business-analytics/functionality/projects-bookkeeping.md",
      "meta/system-analytics/functionality/projects-bookkeeping.md",
      "meta/business-analytics/functionality/interview-questions-interval-repetition.md",
      "meta/system-analytics/functionality/interview-questions-interval-repetition.md"
    ],
    "approvedAssumptions": [
      "The homepage submission shortcut opens My Projects in submission-choice context with the prompt Выберите проект для сдачи.",
      "Profile identity, role, project count, achievement states, activity entries, dates, and community totals are representative personalized mock data",
      "The homepage offers mentor discovery as a product navigation entry even though the current mentor requirements do not yet define the discovery flow",
      "The homepage includes a representative recent-activity feed and community-wide promotional statistics",
      "Roadmap, community chat, and YouTube identifiers are application-configured external destinations rather than literal URLs in this specification",
      "Quick-action labels, timeline content, statistics, and external-link labels wrap within the 342-pixel mobile content width",
      "The homepage exposes an interval-repetition entry point",
      "Homepage-only repair preserves native controls and approved structural Card shells; locked achievement Avatars use muted opacity, activity follows source order, and scoped accessible blue does not change shared mains",
      "The entry opens CategorySetup when no categories are selected and RepetitionDashboard otherwise"
    ]
  }
}
