{
  "$schema": "../../schemas/page.schema.json",
  "feature": {
    "key": "interval-repetition",
    "label": "Interval Repetition"
  },
  "page": "CategoryDetails",
  "frame": {
    "width": 390,
    "background": "color.background",
    "padding": "spacing.md"
  },
  "layout": {
    "type": "column",
    "gap": "spacing.md",
    "align": "stretch"
  },
  "children": [
    {
      "type": "library-component",
      "library": "primevue",
      "component": "Toolbar",
      "design": {
        "appearance": "page-header",
        "state": "back"
      },
      "slots": {
        "start": [
          {
            "type": "library-component",
            "library": "primevue",
            "component": "Button",
            "props": {
              "aria-label": "Назад",
              "icon": "pi pi-arrow-left",
              "iconPos": "left",
              "severity": "primary",
              "variant": "text"
            },
            "action": {
              "type": "command",
              "name": "goBack"
            },
            "design": {
              "appearance": "primary",
              "variant": "text",
              "size": "normal",
              "state": "default",
              "colorTreatment": "accessible-blue"
            }
          },
          {
            "type": "text",
            "name": "PageTitle",
            "value": "Core"
          }
        ]
      }
    },
    {
      "type": "library-component",
      "library": "primevue",
      "component": "Tag",
      "props": {
        "value": "Java",
        "severity": "info"
      },
      "design": {
        "appearance": "specialization",
        "state": "default",
        "colorTreatment": "accessible-blue"
      }
    },
    {
      "type": "grid",
      "name": "MetricsGrid",
      "columns": 3,
      "gap": "spacing.sm",
      "children": [
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Card",
          "design": {
            "appearance": "metric",
            "state": "default"
          },
          "slots": {
            "content": [
              {
                "type": "text",
                "name": "TotalMetric",
                "value": "38\nвсего"
              }
            ]
          }
        },
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Card",
          "design": {
            "appearance": "metric",
            "state": "default"
          },
          "slots": {
            "content": [
              {
                "type": "text",
                "name": "DueMetric",
                "value": "6\nк повторению",
                "style": {
                  "color": "color.accessiblePrimary"
                }
              }
            ]
          }
        },
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Card",
          "design": {
            "appearance": "metric",
            "state": "default"
          },
          "slots": {
            "content": [
              {
                "type": "text",
                "name": "NewMetric",
                "value": "24\nновых"
              }
            ]
          }
        }
      ]
    },
    {
      "type": "library-component",
      "library": "primevue",
      "component": "Button",
      "name": "CategorySelectionAction",
      "props": {
        "label": "Удалить из повторения",
        "severity": "danger"
      },
      "action": {
        "type": "command",
        "name": "removeCategory"
      },
      "design": {
        "appearance": "danger",
        "variant": "filled",
        "size": "normal",
        "state": "default"
      }
    },
    {
      "type": "section",
      "name": "QuestionList",
      "children": [
        {
          "type": "text",
          "name": "QuestionListTitle",
          "value": "Вопросы",
          "style": {
            "fontSize": "font.size.lg",
            "fontWeight": "font.weight.bold",
            "color": "color.text"
          }
        },
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Accordion",
          "props": {
            "value": [
              "question-2"
            ],
            "multiple": true
          },
          "design": {
            "appearance": "default",
            "state": "expanded"
          },
          "slots": {
            "default": [
              {
                "type": "library-component",
                "library": "primevue",
                "component": "AccordionPanel",
                "props": {
                  "value": "question-1"
                },
                "design": {
                  "appearance": "due",
                  "state": "collapsed"
                },
                "slots": {
                  "header": [
                    {
                      "type": "text",
                      "name": "QuestionOne",
                      "value": "Как работает HashMap внутри?"
                    }
                  ],
                  "content": [
                    {
                      "type": "text",
                      "name": "AnswerOne",
                      "value": "Каноничный ответ скрыт до раскрытия вопроса."
                    }
                  ]
                }
              },
              {
                "type": "library-component",
                "library": "primevue",
                "component": "AccordionPanel",
                "props": {
                  "value": "question-2"
                },
                "design": {
                  "appearance": "default",
                  "state": "expanded"
                },
                "slots": {
                  "header": [
                    {
                      "type": "text",
                      "name": "QuestionTwo",
                      "value": "В чём разница между equals и hashCode?"
                    }
                  ],
                  "content": [
                    {
                      "type": "text",
                      "name": "AnswerTwo",
                      "value": "Равные объекты должны возвращать одинаковый hashCode. Обратное правило не обязательно."
                    }
                  ]
                }
              },
              {
                "type": "library-component",
                "library": "primevue",
                "component": "AccordionPanel",
                "props": {
                  "value": "question-3"
                },
                "design": {
                  "appearance": "new",
                  "state": "collapsed"
                },
                "slots": {
                  "header": [
                    {
                      "type": "text",
                      "name": "QuestionThree",
                      "value": "Что такое immutable-объект?"
                    }
                  ],
                  "content": [
                    {
                      "type": "text",
                      "name": "AnswerThree",
                      "value": "Каноничный ответ скрыт до раскрытия вопроса."
                    }
                  ]
                }
              },
              {
                "type": "library-component",
                "library": "primevue",
                "component": "AccordionPanel",
                "props": {
                  "value": "question-4"
                },
                "design": {
                  "appearance": "scheduled",
                  "state": "collapsed"
                },
                "slots": {
                  "header": [
                    {
                      "type": "text",
                      "name": "QuestionFour",
                      "value": "Как устроен String Pool?"
                    }
                  ],
                  "content": [
                    {
                      "type": "text",
                      "name": "AnswerFour",
                      "value": "Каноничный ответ скрыт до раскрытия вопроса."
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "type": "section",
      "name": "StickyActionBar",
      "children": [
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Button",
          "props": {
            "label": "Повторить тему",
            "icon": "pi pi-play",
            "iconPos": "left",
            "severity": "primary",
            "fluid": true
          },
          "action": {
            "type": "navigate",
            "target": "ReviewSession"
          },
          "design": {
            "appearance": "primary",
            "variant": "filled",
            "size": "normal",
            "state": "default",
            "colorTreatment": "accessible-blue"
          }
        }
      ]
    }
  ],
  "states": {
    "loading": "Metrics and questions use PrimeVue Skeleton placeholders",
    "emptyQuestions": "A page-local empty composition replaces QuestionList",
    "selected": "Default preview: CategorySelectionAction is a danger PrimeVue Button labelled Удалить из повторения with command removeCategory. Review category is available subject to due count",
    "unselected": "Replace CategorySelectionAction with a primary PrimeVue Button labelled Добавить на повторение with command addCategory; keep metrics and question browsing visible. Review category is disabled until add succeeds",
    "addOrRemoveSaving": "For addCategory or removeCategory, CategorySelectionAction retains its label, shows PrimeVue Button loading state and is disabled. Prevent duplicate mutations and disable review until the request completes",
    "addSuccess": "After addCategory succeeds, stay on CategoryDetails, switch to selected, refresh selection and metrics, and enable review subject to due count",
    "removeSuccess": "After removeCategory succeeds, stay on CategoryDetails, switch to unselected, refresh selection and metrics, and disable review",
    "mutationFailure": "Preserve the last confirmed selection and question browsing, leave metrics unchanged, restore the appropriate Add or Remove action, and show an error PrimeVue Message with a page-local retry Button invoking the failed addCategory or removeCategory command. Do not switch selection or navigate on failure",
    "nothingDue": "Review category uses PrimeVue Button disabled state",
    "error": "A load error PrimeVue Message offers retry of category details loading; keep this distinct from mutationFailure"
  },
  "requirements": {
    "sources": [
      "meta/business-analytics/functionality/interview-questions-interval-repetition.md",
      "meta/system-analytics/functionality/interview-questions-interval-repetition.md"
    ],
    "approvedAssumptions": [
      "Canonical answers may be browsed outside a review session",
      "Learned status is not displayed unless the backend formally supplies it",
      "Selection changes only after add or remove succeeds; both success paths remain on CategoryDetails",
      "Approved scoped accessible-blue treatment uses color.accessiblePrimary without changing the global primary token or unrelated artwork"
    ]
  }
}
