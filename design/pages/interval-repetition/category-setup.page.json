{
  "$schema": "../../schemas/page.schema.json",
  "feature": {
    "key": "interval-repetition",
    "label": "Interval Repetition"
  },
  "page": "CategorySetup",
  "frame": {
    "width": 390,
    "background": "color.background",
    "padding": "spacing.md"
  },
  "layout": {
    "type": "column",
    "gap": "spacing.md",
    "align": "stretch"
  },
  "children": [
    {
      "type": "library-component",
      "library": "primevue",
      "component": "Toolbar",
      "design": {
        "appearance": "page-header",
        "state": "root"
      },
      "slots": {
        "center": [
          {
            "type": "text",
            "name": "PageTitle",
            "value": "Выберите темы"
          }
        ]
      }
    },
    {
      "type": "text",
      "name": "IntroText",
      "value": "Добавьте темы, которые хотите регулярно повторять.",
      "style": {
        "fontSize": "font.size.sm",
        "color": "color.mutedText"
      }
    },
    {
      "type": "text",
      "name": "SelectionSummary",
      "value": "Выбрано: 3",
      "style": {
        "fontSize": "font.size.sm",
        "fontWeight": "font.weight.semibold",
        "color": "color.accessiblePrimary"
      }
    },
    {
      "type": "section",
      "name": "SpecializationList",
      "children": [
        {
          "type": "column",
          "name": "JavaSpecialization",
          "gap": "spacing.sm",
          "children": [
            {
              "type": "library-component",
              "library": "primevue",
              "component": "Tag",
              "props": {
                "value": "Java",
                "severity": "info"
              },
              "design": {
                "appearance": "specialization",
                "state": "default",
                "colorTreatment": "accessible-blue"
              }
            },
            {
              "type": "custom-component",
              "component": "CategorySelectionRow",
              "variant": "selected",
              "props": {
                "title": "Core",
                "questionCount": "38 вопросов",
                "action": "Выбрано"
              }
            },
            {
              "type": "custom-component",
              "component": "CategorySelectionRow",
              "variant": "selected",
              "props": {
                "title": "Collections",
                "questionCount": "27 вопросов",
                "action": "Выбрано"
              }
            },
            {
              "type": "custom-component",
              "component": "CategorySelectionRow",
              "variant": "available",
              "props": {
                "title": "Concurrency",
                "questionCount": "24 вопроса",
                "action": "Добавить"
              }
            }
          ]
        },
        {
          "type": "column",
          "name": "BackendSpecialization",
          "gap": "spacing.sm",
          "children": [
            {
              "type": "library-component",
              "library": "primevue",
              "component": "Tag",
              "props": {
                "value": "Backend",
                "severity": "info"
              },
              "design": {
                "appearance": "specialization",
                "state": "default",
                "colorTreatment": "accessible-blue"
              }
            },
            {
              "type": "custom-component",
              "component": "CategorySelectionRow",
              "variant": "selected",
              "props": {
                "title": "SQL",
                "questionCount": "22 вопроса",
                "action": "Выбрано"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "name": "StickyActionBar",
      "children": [
        {
          "type": "library-component",
          "library": "primevue",
          "component": "Button",
          "props": {
            "label": "Продолжить",
            "severity": "primary",
            "fluid": true
          },
          "action": {
            "type": "submit",
            "name": "saveInitialCategorySelection"
          },
          "design": {
            "appearance": "primary",
            "variant": "filled",
            "size": "normal",
            "state": "default",
            "colorTreatment": "accessible-blue"
          }
        }
      ]
    }
  ],
  "states": {
    "loading": "Rows use CategorySelectionRow.disabled placeholders",
    "empty": "A page-local empty composition is shown when no categories are available",
    "disabled": "Continue uses PrimeVue Button disabled state while selection is empty",
    "saving": "saveInitialCategorySelection submits all selected category IDs in one bulk save. Continue uses PrimeVue Button loading state, all rows are disabled, and duplicate submission is prevented",
    "saveSuccess": "Only after the bulk save succeeds, navigate to RepetitionDashboard",
    "saveFailure": "Stay on CategorySetup, preserve selected category IDs, re-enable selection and Continue, and show an error PrimeVue Message with a page-local retry Button invoking saveInitialCategorySelection. Retry submits the current selection; never navigate on failure"
  },
  "requirements": {
    "sources": [
      "meta/business-analytics/functionality/interview-questions-interval-repetition.md",
      "meta/system-analytics/functionality/interview-questions-interval-repetition.md"
    ],
    "approvedAssumptions": [
      "First-time category selection is confirmed in one bulk save",
      "Continue is disabled when no category is selected",
      "Approved scoped accessible-blue treatment uses color.accessiblePrimary without changing the global primary token or unrelated artwork"
    ]
  }
}
